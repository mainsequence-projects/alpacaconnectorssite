# Exact trusted Command Center parent origin used by the iframe protocol.
VITE_COMMAND_CENTER_ORIGIN=https://command-center.example.com

# Public UID of the deployed FastAPI ResourceRelease.
VITE_FASTAPI_RESOURCE_RELEASE_UID=00000000-0000-4000-8000-000000000000

# Local development only: the target of the dev server's authenticated API proxy (vite.config.ts).
# Production builds ignore it. Never put a token here; the proxy reads `mainsequence auth token`.
VITE_API_BASE_URL=http://127.0.0.1:8321

# Local development only, not a VITE_ value: the platform whose saved session (`npx command-center-sdk
# login`) the dev server's platformRequestProxy() uses for the Alpaca Agent conversation. The Agent
# and its Environment come from the API, never from this file.
# MAINSEQUENCE_ENDPOINT=http://127.0.0.1:8000
